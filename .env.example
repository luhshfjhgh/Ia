# ╔══════════════════════════════════════════╗
# ║       NOX AI — Exemplo de .env           ║
# ╚══════════════════════════════════════════╝
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env

# ── API ────────────────────────────────────
NOX_API_URL=https://api.groq.com/openai/v1/chat/completions
NOX_API_KEY=sua_chave_aqui
NOX_MODEL=openai/gpt-oss-120b
NOX_MAX_TOKENS=1024
NOX_TEMPERATURE=0.85

# ── Seleção automática de modelo (NOX AI Developer Edition) ──
# Modelo usado automaticamente quando o usuário pede para criar sites,
# landing pages, dashboards, sistemas web, apps React/Next.js, SaaS, etc.
# A troca é 100% automática — não precisa configurar nada para funcionar,
# mas você pode customizar qual modelo é usado:
# NOX_MODEL_DEV foi removido — tarefas de dev são roteadas para o sistema multiagente

# ── Voz ────────────────────────────────────
NOX_VOICE_ENABLED=false
NOX_TTS_VOICE=pt-BR-FranciscaNeural

# ── Comportamento ───────────────────────────
NOX_MAX_HISTORY_CONTEXT=20
NOX_TYPING_DELAY=0.018
NOX_LANGUAGE=pt-BR
NOX_SHOW_TIMESTAMPS=false
NOX_AUTO_SAVE_INTERVAL=10

# ── Ollama (modo offline) ──────────────────────────────────
# Instale em: https://ollama.com/download
# Modelo recomendado para PC fraco (4-8GB RAM):
OLLAMA_MODEL=gemma2:2b
# Para PC médio/bom, pode usar:
# OLLAMA_MODEL=gemma2:9b
# OLLAMA_MODEL=llama3:8b

# ── Replicate (Geração de Imagens — /imagine) ─────────────────────────
# Obtenha em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=seu_token_replicate_aqui

# ── Hugging Face (modelo de programação — modo Developer) ────────────
# Crie sua conta e gere um token gratuito em:
# https://huggingface.co/settings/tokens
# (marque a permissão "Make calls to Inference Providers")
HF_TOKEN=seu_token_huggingface_aqui
# Modelo usado para gerar código quando os agentes falham/indisponíveis.
# Pode trocar por qualquer outro modelo de código disponível na HF.
HF_CODE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# ── Spotify (tocar música específica por voz, sem abrir nada) ────────
# 1. Crie um app em https://developer.spotify.com/dashboard
# 2. Em "Redirect URI" adicione EXATAMENTE: http://127.0.0.1:8888/callback
# 3. Cole o Client ID e Client Secret abaixo
# 4. Rode /spotify_login dentro da Nox (uma vez só)
SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui
# Preenchido automaticamente pelo /spotify_login — não editar à mão:
SPOTIFY_REFRESH_TOKEN=
